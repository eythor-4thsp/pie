# Pilot server
PORT=8787
# Where the SQLite file lives. The folder is created on first start.
DATA_DIR=./data
# The address guests see in texts, e.g. https://pie.example.com
PUBLIC_URL=http://localhost:8787
# Seed the fictional club into an empty database (1) or start empty (0)
SEED=1

# One notification channel. Leave these unset to print texts to the console
# and show login codes in the app (demo mode).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+12125550000
