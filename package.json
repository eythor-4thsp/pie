{
  "name": "pie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/index.mjs --packages=external",
    "server": "tsx server/index.ts",
    "start": "node server-dist/index.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
